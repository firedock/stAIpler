{
  "name": "@staipler/core",
  "version": "0.1.0",
  "description": "AI agent context optimizer — scanner, analyzer, compiler, and optimizer for instruction layers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
